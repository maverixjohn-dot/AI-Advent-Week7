# ===== Обязательные =====
# Путь к локальному репозиторию с XML-выгрузкой конфигурации (git init уже сделан там)
A1C_DUMP_ROOT=/path/to/LifeProgect
# Ключ DeepSeek. Все параметры читаются из окружения процесса; .env — лишь
# способ задать переменные, которых в окружении нет (существующие переменные
# окружения приоритетнее значений из .env). Если DEEPSEEK_API_KEY уже задан
# в переменных окружения — здесь его указывать не нужно.
# DEEPSEEK_API_KEY=sk-...

# ===== Необязательные (дефолты разумные) =====
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# Режим рассуждения (thinking) — параметр запроса: 1=вкл, 0=выкл
DEEPSEEK_THINKING=1
# Модель эмбеддингов (как в rag-1c)
A1C_EMBED_MODEL=intfloat/multilingual-e5-large
A1C_EMBED_DEVICE=cpu
# Сколько чанков возвращает RAG-поиск
A1C_RAG_TOP_K=5
# Только для автономных тестов без HuggingFace: детерминированный псевдо-энкодер
# A1C_EMBED_BACKEND=hash
